source: reviews is duckdb.table('reviews.csv') extend {
  measure: review_count is count()
  measure: avg_rating is avg(Rating)
}

run: reviews -> {
  group_by: `Division Name`
  aggregate: 
    review_count
    avg_rating
  order_by: review_count desc
}
run: reviews -> {
  group_by: `Department Name`
  aggregate:
    review_count
    avg_rating
  order_by: avg_rating desc
}

run: reviews -> {
  group_by: Age
  aggregate:
    review_count
    avg_rating
  order_by: Age asc
}

run: reviews -> {
  group_by: `Department Name`
  aggregate: 
    recommended is avg(`Recommended IND`) * 100
  order_by: recommended desc
}